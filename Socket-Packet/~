#pragma once
#include <glm/glm.hpp>
#include <stdexcept>
#include <iostream>
#include "mySerialization.hpp"


enum packetTypeEnum {
	POSITION_PACKET,
	STATUS_PACKET
};

// serialize_data in these cases means that these methods will either fill out the Packet class
// from the ReadStream or write from it to the WriteStream depending on what's passed down as the type Stream

class PacketPosition {
	private:
		uint32_t packetType = packetTypeEnum::POSITION_PACKET;
		glm::vec3 position_;
		glm::vec3 front_;
	public:
		PacketPosition() = default;
		PacketPosition(glm::vec3& position, glm::vec3& front);

		//Temporary for testing outputs
		friend std::ostream& operator<<(std::ostream& out, const PacketPosition& packet);

		//Is responsible for for either writing or reading from the Streams 
		template<typename Stream> void serializeData(Stream& stream) {

			serializeInt32(stream, this->packetType); //Somewhere here now is a necessary check
																									//if a valid packet has been received
			if(Stream::isReading) {
				std::cout << "Packet type value received: " << this->packetType << std::endl; // Debug
				//This is definitely not the way to go but the idea is here I think
				if((packetType != packetTypeEnum::STATUS_PACKET) && 
					 (packetType != packetTypeEnum::POSITION_PACKET)) {
						throw std::invalid_argument("Not a correct type of packet");
				}
			}

			if(Stream::isWriting)
				std::cout << "The writing side has this as the packet type: " << this->packetType << std::endl; //Debug

			serializeVec3(stream, this->position_);
			serializeVec3(stream, this->front_);
		}
};

class PacketStatus {
	private:
		uint32_t packetType = packetTypeEnum::STATUS_PACKET;
		uint32_t health_;
		uint32_t mana_;
		uint32_t stamina_;
	public:
		PacketStatus() = default;
		PacketStatus(uint32_t health, uint32_t mana, uint32_t bullets);

		template<typename Stream> void serializeData(Stream& stream) {
			serializeInt32(stream, this->packetType);

			if(Stream::isReading) {
				//Check for the correct type
			}

			serializeInt32(stream, this->health_);
			serializeInt32(stream, this->mana_);
			serializeInt32(stream, this->stamina_);
		}
};
